# Microsoft personal-account app registration (optional; built-in development ID otherwise)
NEXT_PUBLIC_AZURE_CLIENT_ID=

# Google OAuth web client. Leave empty to hide the Google provider.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_GOOGLE_PROVIDER=true

# GitHub Pages subpath, for example /ArrangeV4
NEXT_PUBLIC_BASE_PATH=

# Displayed in the app UI; CI sets this automatically.
NEXT_PUBLIC_APP_VERSION=local
